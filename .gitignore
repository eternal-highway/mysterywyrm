# Full-resolution image archive (~742 MB) - materialize with:
#   python3 tools/archive.py --variant full --images-dir archive/full \
#           --skip-pages --manifest data/media-full.json
# The images stay out; data/media-full.json is committed, because it is the
# only thing that can certify a copy of the originals. See research/archive.md.
archive/full/

# The 17 Rune Code plates at full resolution (~75 MB) - materialize with:
#   python3 tools/archive.py --tag "Rune Code" --variant full \
#           --images-dir archive/code --manifest data/media-code.json --skip-pages
# Their checksums are committed in data/media-code.json, which is NOT ignored,
# so a fresh clone can verify them. See research/rune-code.md.
archive/code/

__pycache__/
*.pyc
